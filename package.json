{
  "name": "emitochondria",
  "version": "1.2.2",
  "type": "module",
  "description": "The powerhouse of your events — A tiny, fully-typed event emitter for TypeScript with built-in error handling and memory leak detection",
  "author": "Pablo Díaz A.K.A exudev",
  "license": "MIT",
  "bin": {
    "emitochondria": "./bin/emitochondria.cjs"
  },
  "keywords": [
    "events",
    "emitter",
    "event-emitter",
    "typescript",
    "typed",
    "pubsub",
    "pub-sub",
    "subscribe",
    "publish",
    "error-handling",
    "memory-leak-detection",
    "async",
    "type-safe"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Exudev/emitochondria.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "bin",
    "schema.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run test:run && npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}