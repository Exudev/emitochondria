{
  "name": "emitochondria",
  "version": "1.0.0",
  "type": "module",
  "description": "The powerhouse of your events — A tiny, fully-typed event emitter for TypeScript",
  "author": "Pablo Díaz A.K.A exudev",
  "license": "MIT",
  "keywords": [
    "events",
    "emitter",
    "event-emitter",
    "typescript",
    "typed",
    "pubsub",
    "pub-sub",
    "subscribe",
    "publish"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Exudev/emitochondria.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run test:run && npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "emitochondria": "^1.0.0"
  }
}